root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = android_studio
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# @Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Compose rules (io.nlopez.compose.rules): https://mrmans0n.github.io/compose-rules/ktlint/
# The metal palette has no Material role, so the theme provides it through its own CompositionLocal.
# The device host gives each screen its input through one, so a screen doesn't name its key (ADR-019).
compose_allowed_composition_locals = LocalMetalColors,LocalRolaboxTextStyles,LocalScreenInput

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
