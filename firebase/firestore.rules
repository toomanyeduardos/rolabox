rules_version = '2';

// Security rules for Rolabox's Firestore database (ADR-010, ADR-011).
//
// The Firebase config is public (it's inside every cloud APK), so these rules are the only thing
// protecting user data. Anything not matched below is denied, including subcollections under
// users/{uid} until they get their own match block.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Placeholder schema until sync defines real data (ADR-010):
    //   createdAt   timestamp, required; the server time on create, and never changed after that
    //   displayName string of 1 to 100 characters, optional
    function isValidUser(data) {
      return data.keys().hasOnly(['createdAt', 'displayName'])
        && data.createdAt is timestamp
        && (!('displayName' in data)
          || (data.displayName is string
            && data.displayName.size() >= 1
            && data.displayName.size() <= 100));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && isValidUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Synced preferences (ADR-011). Each field is a map, { value, updatedAt }, and devices resolve
    // conflicts with last-write-wins. The values must be the enum names the app knows, so a new
    // value needs a rules change first. A timestamp may be at most a day ahead of the server, so a
    // device with a badly wrong clock can't make its value win for years, and an update may never
    // move a field back in time or remove it.
    function isValidSyncedField(data, field, allowed) {
      return !(field in data)
        || (data[field] is map
          && data[field].keys().hasOnly(['value', 'updatedAt'])
          && data[field].keys().hasAll(['value', 'updatedAt'])
          && data[field].value in allowed
          && data[field].updatedAt is timestamp
          && data[field].updatedAt <= request.time + duration.value(1, 'd'));
    }

    function isValidPreferences(data) {
      return data.keys().hasOnly(['darkThemeConfig', 'accentColor'])
        && isValidSyncedField(data, 'darkThemeConfig', ['FOLLOW_SYSTEM', 'LIGHT', 'DARK'])
        && isValidSyncedField(data, 'accentColor', ['BLUE', 'GREEN', 'PURPLE', 'PINK']);
    }

    function isNotOlder(field) {
      return !(field in resource.data)
        || (field in request.resource.data
          && request.resource.data[field].updatedAt >= resource.data[field].updatedAt);
    }

    match /users/{uid}/settings/preferences {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidPreferences(request.resource.data);
      allow update: if isOwner(uid)
        && isValidPreferences(request.resource.data)
        && isNotOlder('darkThemeConfig')
        && isNotOlder('accentColor');
    }
  }
}
