    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <!-- 240dp icon canvas; the disc (60 of 108 units, about 133dp) sits inside the 160dp safe circle. -->
        <vector
            android:width="240dp"
            android:height="240dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group android:name="disc" android:pivotX="54" android:pivotY="54">
                <path android:fillColor="#0B0B0B" android:pathData="M54,24 a30,30 0 1,1 0,60 a30,30 0 1,1 0,-60 Z"/>
                <path android:strokeColor="#1F1F1F" android:strokeWidth="0.6" android:pathData="M54,42 a12,12 0 1,1 0,24 a12,12 0 1,1 0,-24 Z"/>
                <path android:strokeColor="#1F1F1F" android:strokeWidth="0.6" android:pathData="M54,38 a16,16 0 1,1 0,32 a16,16 0 1,1 0,-32 Z"/>
                <path android:strokeColor="#1F1F1F" android:strokeWidth="0.6" android:pathData="M54,34 a20,20 0 1,1 0,40 a20,20 0 1,1 0,-40 Z"/>
                <path android:strokeColor="#1F1F1F" android:strokeWidth="0.6" android:pathData="M54,30 a24,24 0 1,1 0,48 a24,24 0 1,1 0,-48 Z"/>
                <path android:strokeColor="#1F1F1F" android:strokeWidth="0.6" android:pathData="M54,26 a28,28 0 1,1 0,56 a28,28 0 1,1 0,-56 Z"/>
