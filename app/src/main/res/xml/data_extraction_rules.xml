<?xml version="1.0" encoding="utf-8"?>
<!-- What Android backs up, on Android 12 and up: the same include-list in both, and in backup_rules.xml (ADR-036). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
        <include domain="database" path="podcasts.db" />
        <include domain="database" path="podcasts.db-wal" />
        <include domain="database" path="podcasts.db-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
        <include domain="database" path="podcasts.db" />
        <include domain="database" path="podcasts.db-wal" />
        <include domain="database" path="podcasts.db-shm" />
    </device-transfer>
</data-extraction-rules>
