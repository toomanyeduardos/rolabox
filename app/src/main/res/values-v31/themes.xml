<?xml version="1.0" encoding="utf-8"?>
<!--
  The system splash only supports a branding image (the wordmark and tagline) on Android 12+. It
  repeats the theme in values/ because a style in a more specific folder replaces it whole. Older
  versions show the wordmark once RolaboxSplash is up.
-->
<resources>
    <style name="Theme.Rolabox.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_vinyl_spin</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Rolabox</item>
    </style>
</resources>
